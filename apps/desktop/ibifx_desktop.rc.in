// Recursos do executável no Windows: o ícone (Explorer, barra de tarefas,
// atalhos) e a aba "Detalhes" das propriedades do arquivo. Gerado pelo
// CMake a partir deste .in, para que a versão venha de project(VERSION).

IDI_ICON1 ICON "@IBIFX_ICON_PATH@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "CompanyName", "IbiFX"
            VALUE "FileDescription", "IbiFX - pedaleira e ferramentas de pratica para guitarra"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "ibifx_desktop"
            VALUE "LegalCopyright", "Copyright (c) 2026 Leandro - MIT License"
            VALUE "OriginalFilename", "IbiFX.exe"
            VALUE "ProductName", "IbiFX"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
